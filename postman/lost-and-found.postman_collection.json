    {
      "name": "3. Categories",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const wallets = pm.response.json().find((c) => c.slug === 'billeteras');",
                  "if (wallets) pm.collectionVariables.set('categoryId', wallets.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Posts",
      "item": [
        {
          "name": "Publicar objeto ENCONTRADO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"FOUND\",\n  \"title\": \"Billetera de cuero marrón\",\n  \"description\": \"La encontré en un banco de Plaza de Mayo, cerca de la catedral.\",\n  \"categoryId\": {{categoryId}},\n  \"attributes\": {\n    \"color\": \"marrón\",\n    \"brand\": \"Prune\"\n  },\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"location\": {\n    \"lat\": -34.60837,\n    \"lng\": -58.37224\n  },\n  \"radiusM\": 50,\n  \"locationLabel\": \"Plaza de Mayo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('postId', json.id);",
                  "pm.test('el autor ve la ubicación exacta', () => pm.expect(json.location).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar objeto PERDIDO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"LOST\",\n  \"title\": \"Perdí mi billetera marrón\",\n  \"description\": \"Se me cayó caminando por Plaza de Mayo, tiene mi DNI adentro.\",\n  \"categoryId\": {{categoryId}},\n  \"attributes\": {\n    \"color\": \"marrón\",\n    \"brand\": \"Prune\"\n  },\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"location\": {\n    \"lat\": -34.6079,\n    \"lng\": -58.3731\n  },\n  \"radiusM\": 300,\n  \"locationLabel\": \"Plaza de Mayo / Catedral\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('lostPostId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar - sin token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"FOUND\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar - body inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"STOLEN\",\n  \"title\": \"x\",\n  \"description\": \"corta\",\n  \"categoryId\": 1,\n  \"occurredAt\": \"2999-01-01T00:00:00Z\",\n  \"location\": {\n    \"lat\": 200,\n    \"lng\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar publicaciones abiertas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar con filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?type=FOUND&categoryId={{categoryId}}&status=OPEN&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "FOUND"
                },
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}"
                },
                {
                  "key": "status",
                  "value": "OPEN"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
