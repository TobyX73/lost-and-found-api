          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
